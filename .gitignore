__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/

# Perimeter: never stage a live install's credentials or private homes.
# config/ holds provider keys, bot tokens, hive tokens, allowlists;
# cousins/ holds the fleet's private homes. The gate is the backstop;
# this keeps them from ever reaching staging. The ignore excludes the
# CONTENTS of config/ (not the directory) so the .example re-include
# can fire - git does not descend into an excluded directory to reach
# a carve-out. Safe example configs ship as config/*.example.
config/*
!config/*.example
cousins/

# Runtime state the framework writes under the root: the loops daemon's
# request store and state, job logs, the tool-surface manifest. All of
# it is regenerated; none of it is source.
/data/

# The root's shared tier: reviewed shared memory and the hive database,
# which holds bearer tokens. One install's state, never source.
/shared/

# A built hive node archive holds a bearer token and is a binary the
# gate refuses; cousin-spawn-node writes it where --out says, and it
# must never stage from a checkout.
*-node.tar.gz
