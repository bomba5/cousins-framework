# config/harness.toml preset for Claude Code as the agent harness.
# Copy to config/harness.toml:
#   cp config/harness.toml.claude-code.example config/harness.toml
# See config/harness.toml.example for what every key means.
#
# What it turns on: transcript mining at flip, the harness auto-memory
# search collection, the console's token counts, the loops daemon's
# transcript-size guard, `cousin-mcp approve`, and the console's
# "needs attention" flag for a session parked on the login menu.
#
# A leading ~ is the home of the account the framework runs as.
# {home_encoded} is Claude Code's project-directory name for the cousin
# home: every "/" becomes "-". If your checkout path holds characters
# other than letters, digits, "-" and "/", compare with the directory
# Claude Code actually created under ~/.claude/projects/ and write that
# path out instead.

transcripts_dir = "~/.claude/projects/{home_encoded}"
auto_memory_dir = "~/.claude/projects/{home_encoded}/memory"
flip_when_transcript_mb = 100
settings_file = "~/.claude.json"

# Pane text that means the agent is waiting on a person, not working:
# Claude Code's first-run login menu and its OAuth code prompt. Run
# `claude` once interactively (or `claude auth login`) before starting
# a cousin so neither appears.
attention_patterns = [
    "Select login method",
    "Paste code here if prompted",
    "OAuth error",
    "Press Enter to retry",
    "Choose the text style",
    "Yes, I trust this folder",
    "Do you want to use this API key",
]

# Pane text (regular expressions) that means the agent is mid-turn:
# Claude Code's spinner line ("* Cogitating... (12s . esc to
# interrupt)"). A finished turn reads "* Worked for 7m 28s", which
# neither matches. `cousin-auth` and the console refuse to restart a
# cousin whose visible pane matches, unless forced.
busy_patterns = [
    "esc to interrupt",
    "^\\s*\\S\\s+\\w+(\u2026|\\.\\.\\.)\\s+\\(\\d+[smh]",
]

# Claude Code's vim editing mode: in NORMAL mode typed text is read as
# commands. The injector presses insert_keys first when the pane shows
# normal_marker, so a chat line is typed, not swallowed.
[input_mode]
normal_marker = "-- NORMAL --"
insert_keys = "i"

[agent]
default_model = "claude-opus-5"
default_effort = "high"
# models: leave unset so the console offers the built-in catalogue
# (cousin_lib/config.py DEFAULT_MODELS), which tracks code updates.

# How config/agent-cmd resumes an existing session instead of starting
# a new one: an auth-mode switch restarts the agent on the SAME
# session, so the conversation carries over. session_arg must appear
# in config/agent-cmd verbatim.
[agent.resume]
session_arg = "--session-id {session_id}"
resume_arg = "--resume {session_id}"

# The api_key auth mode (cousin-auth <slug> api_key). With its own
# login present AND ANTHROPIC_API_KEY set, Claude Code bills the login
# ("Both claude.ai and ANTHROPIC_API_KEY set"), so api_key mode also
# points it at an isolated config dir without the login: every entry
# of ~/.claude symlinked except the files below, plus a copy of
# ~/.claude.json without the account block. In claude mode both
# variables are removed from the agent's environment.
[auth.api_key]
key_env = "ANTHROPIC_API_KEY"
config_dir_env = "CLAUDE_CONFIG_DIR"
source_dir = "~/.claude"
settings_file = "~/.claude.json"
settings_name = ".claude.json"
# Relative paths are under the framework root.
isolated_dir = "data/harness-api-key-config"
exclude = [
    ".credentials.json",
    "policy-limits.json",
    "policy-limits.json.stamp.json",
    "remote-settings.json",
    "stats-cache.json",
]
strip_settings_keys = [
    "oauthAccount",
    "hasAvailableSubscription",
    "userID",
    "cachedExtraUsageDisabledReason",
    "subscriptionNoticeCount",
]
# Kept from the previous copy on a rebuild: Claude Code records here
# that the operator accepted the key at its first-run prompt.
preserve_settings_keys = ["customApiKeyResponses"]
# Present in the isolated dir = a login: the launch refuses.
login_files = [".credentials.json"]
# The harness also stores plugin MCP sign-in state in that file; only the
# account login (this key) makes it a login. Unreadable = login (fail closed).
login_file_keys = ["claudeAiOauth"]
login_settings_keys = ["oauthAccount"]
