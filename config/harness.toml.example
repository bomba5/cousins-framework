# config/harness.toml - where the agent harness keeps its per-project
# state for this install. Copy to config/harness.toml and fill in.
#
# Absent file: transcript mining at flip, the harness auto-memory
# search collection and the loops daemon's transcript-size guard are
# all off (mining says so once at flip). Present but unparsable: a
# loud error, because the file promised something.
#
# The two path values are templates expanded per cousin:
#   {home}          the cousin home, verbatim
#   {home_encoded}  the harness's project-dir encoding of the home:
#                   every "/" becomes "-", so /srv/fw/cousins/testa/files
#                   becomes -srv-fw-cousins-testa-files
#
# Where the harness writes session transcripts (one directory per
# project, JSONL files inside).
#transcripts_dir = "/var/lib/harness/projects/{home_encoded}"
#
# The harness's own auto-memory directory for this cousin. When set it
# becomes a search collection for cousin-memory search.
#auto_memory_dir = "/var/lib/harness/projects/{home_encoded}/memory"
#
# Transcript-size guard (needs transcripts_dir). When a live cousin's
# <transcripts_dir>/<session_id>.jsonl grows past this many megabytes
# the loops daemon submits one timed-flip request for it, five
# minutes out, visible in `cousin-loops requests` with the usual
# warning ladder. At most one cousin per tick; never a second request
# while one is pending. Absent: no guard. Must be a positive number.
#flip_when_transcript_mb = 100
#
# The harness's own settings JSON: the file that records, per project
# path, which .mcp.json servers are approved ("enabledMcpjsonServers")
# and whether the folder is trusted. `cousin-mcp approve <slug>` edits
# exactly this file. Absent: approve refuses and prints the manual
# edit instead of guessing where the harness keeps its settings.
#settings_file = "~/.harness-settings.json"
#
# Install-wide agent defaults. config/agent-cmd may carry {model} and
# {effort} placeholders; each renders from the cousin's own
# cousin.toml [runtime] model / effort, else from these. A placeholder
# with no value in either place is a spawn error that names both
# files. `models` is the catalogue the console's spawn dialog offers;
# absent, a built-in list of three names is offered. `default_effort`
# is one of low, medium, high, max.
#[agent]
#default_model = "some-model"
#default_effort = "high"
#models = ["some-model", "another-model"]
