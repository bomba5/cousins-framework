# config/harness.toml - where the agent harness keeps its per-project
# state for this install. Copy to config/harness.toml and fill in. For
# Claude Code, copy config/harness.toml.claude-code.example instead:
# the same keys, filled in.
#
# Absent file: transcript mining at flip and the harness auto-memory
# search collection are off (mining says so once at flip). Present but
# unparsable: a loud error, because the file promised something.
#
# The keys 2.0.0 removed with the legacy tmux lane (attention_patterns,
# busy_patterns, [input_mode], flip_when_transcript_mb, [agent.resume],
# [auth.api_key]) are not here: docs/configuration.md, "Removed in
# 2.0.0"; `cousin-migrate tidy --all --yes` takes them out of a file.
#
# The two path values are templates expanded per cousin:
#   {home}          the cousin home, verbatim
#   {home_encoded}  the harness's project-dir encoding of the home:
#                   every character other than a letter or a digit
#                   becomes "-", so /srv/fw_1/cousins/testa/files
#                   becomes -srv-fw-1-cousins-testa-files
#
# Where the harness writes session transcripts (one directory per
# project, JSONL files inside).
#transcripts_dir = "/var/lib/harness/projects/{home_encoded}"
#
# The harness's own auto-memory directory for this cousin. When set it
# becomes a search collection for cousin-memory search.
#auto_memory_dir = "/var/lib/harness/projects/{home_encoded}/memory"
#
# The daily flip time for every cousin that does not set its own
# `[lifecycle] flip_at`. A cousin spawned or migrated after you
# configured the fleet would otherwise never flip, and nothing says
# so: it just keeps one session for as long as nobody looks. Absent:
# 04:00. Set it to "never" to make no flip the default instead. A
# single time for the whole fleet is fine - the daemon fires at most
# one flip per tick, so they queue rather than collide.
#default_flip_at = "04:00"
#
# Where the harness keeps its own per-session log for each MCP server.
# The framework reads it to tell a cousin why its MCP server did not
# come up: the harness itself reports only CONNECTION_CLOSED, and the
# server's stderr, which carries the actual reason, is only in here.
# Same templating as transcripts_dir, plus {server}. Absent: Claude
# Code's default, shown below.
#mcp_logs_dir = "~/.cache/claude-cli-nodejs/{home_encoded}/mcp-logs-{server}"
#
# The harness's own settings JSON: the file that records, per project
# path, which .mcp.json servers are approved ("enabledMcpjsonServers")
# and whether the folder is trusted. `cousin-mcp approve <slug>` edits
# exactly this file. Absent: approve refuses and prints the manual
# edit instead of guessing where the harness keeps its settings.
#settings_file = "~/.harness-settings.json"
#
# Install-wide agent defaults: the model and effort the console's
# spawn dialog preselects for a new cousin (it writes them to the
# cousin's [agent]). `models` is the catalogue the dialog offers;
# absent, the built-in catalogue (cousin_lib/config.py DEFAULT_MODELS)
# is offered. `default_effort` is one of low, medium, high, xhigh, max
# (EFFORT_LEVELS there).
#[agent]
#default_model = "some-model"
#default_effort = "high"
#models = ["some-model", "another-model"]
#
# Whether a commit or pull request a cousin makes carries the harness's
# own injected attribution (a Co-Authored-By trailer, a "Generated
# with Claude Code" line). A cousin's own cousin.toml [agent]
# commit_attribution overrides this per cousin. Absent here and in the
# cousin: true, which keeps the harness's stock behaviour - the
# framework is public and does not impose one operator's attribution
# policy on every install. Set it false to have the SDK runner and the
# tmux lane's <home>/.claude/settings.json both turn it off.
#commit_attribution = true
