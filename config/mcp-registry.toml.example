# config/mcp-registry.toml.example - the framework's default MCP tool
# registry. Spec: docs/mcp.md.
#
# This file is the default: cousin-spawn copies it into every new
# cousin's home as <home>/mcp-registry.toml (with the operator filled
# in when spawn was given one), and cousin-mcp reads it when no
# --registry is passed and the cousin home carries none. To change the
# default for one install, copy it to config/mcp-registry.toml and
# edit that; the example is never edited in place.
#
# Every command is a console-script NAME. cousin-mcp resolves a bare
# name beside the interpreter it runs under first, then on PATH, so on
# a machine carrying two installs of these CLIs the one this
# interpreter belongs to wins. A registry may still name an absolute
# path where that is the clearer rule.
#
# The adapter has no built-in tool list: what is here is what a cousin
# gets. Operator-class verbs (spawn, flip, lifecycle surgery, loop
# control, shared-tier review) are absent on purpose and stay absent.
# Never register a CLI that runs a shell on its input.

ceiling = 12          # more enabled tools than this is a registry error
timeout = 120         # seconds per call
max_output = 16000    # characters of stdout returned per call; the rest is cut and said

[tools.memory]
command = "cousin-memory"
description = "Durable memory: search what you wrote, log a decision with its reasoning, remember a fact with its truth level (operator = the operator said it, needs cite), mark a topic obsolete when something superseded it (why required; it leaves the distilled views, raw keeps the history), recall what you wrote (the best matches for a keyword, or the newest entries), walk an entry's provenance (why: what it was built from and what was built on it), checkpoint your current activity."

[tools.memory.properties]
query = { type = "string", description = "search text (search)" }
top = { type = "integer", description = "max results (search)" }
collection = { type = "string", enum = ["memory", "notes", "harness"], description = "limit to one collection (search)" }
json = { type = "boolean", description = "hits as a JSON list (search)" }
topic = { type = "string", description = "decision topic (decide, remember); the topic to retire (obsolete)" }
decision = { type = "string", description = "the decision (decide)" }
reasoning = { type = "string", description = "why (decide)" }
fact = { type = "string", description = "the fact to keep (remember)" }
level = { type = "string", optional = true, enum = ["operator", "framework", "tool", "conclusion", "hypothesis", "obsolete"], description = "truth level (decide, remember); default conclusion; operator needs cite" }
cite = { type = "string", optional = true, description = "where it comes from: chat message id, quote, file, date (decide, remember); required for level operator" }
why = { type = "string", description = "what superseded the topic (obsolete); required, non-empty" }
force = { type = "boolean", description = "mark a topic that has no raw entries yet (obsolete)" }
entry = { type = "string", optional = true, description = "retire one claim of the topic by its id, from `tensions` or `history`; the topic stays (obsolete)" }
derived_from = { type = "array", items = "string", optional = true, description = "entry ids this was built from, one hop (decide, remember); `why` walks it" }
scope = { type = "string", optional = true, description = "what the fact holds for, e.g. 'board rev A' (remember)" }
valid_until = { type = "string", optional = true, description = "when the fact stops holding: ISO date (through that day, UTC) or time; past it the fact leaves the views (remember)" }
id = { type = "string", description = "an entry id, from `history` or a recall line (why)" }
depth = { type = "integer", optional = true, description = "hops to walk each way, 1 to 12; default the whole chain up to 12 (why)" }
keyword = { type = "string", optional = true, description = "what to recall; empty lists the newest entries (recall)" }
last = { type = "integer", description = "how many entries (recall)" }
text = { type = "string", description = "what you are doing now (activity)" }

[tools.memory.commands.search]
argv = ["search", "{query}"]
options = { top = "--top", collection = "--collection", json = "--json" }

[tools.memory.commands.decide]
argv = ["decide", "--stdin"]
options = { level = "--level", cite = "--cite", derived_from = "--derived-from" }
stdin = ["topic", "decision", "reasoning"]
stdin_sep = "---"

[tools.memory.commands.remember]
argv = ["remember", "{topic}", "{fact}"]
options = { level = "--level", cite = "--cite", derived_from = "--derived-from", scope = "--scope", valid_until = "--valid-until" }

[tools.memory.commands.why]
argv = ["why", "{id}"]
options = { json = "--json", depth = "--depth" }

[tools.memory.commands.obsolete]
argv = ["obsolete", "{topic}"]
options = { why = "--why", force = "--force", entry = "--entry" }

[tools.memory.commands.recall]
argv = ["recall", "{keyword}"]
options = { last = "--last" }

[tools.memory.commands.activity]
argv = ["activity", "{text}"]

[tools.send]
kind = "send"
description = "Send a message to a peer cousin (by slug) or to a configured operator (by name). The destination decides the delivery path; an unknown destination is an error, never a default. A cousin absent from the peer list is not reachable here."
operators = []
peers_from = ["cousin-chat", "list"]
# false makes an unknown-destination error give a COUNT of known peers
# instead of their names, for an install whose peer list carries a
# name a caller must not learn.
errors_name_peers = true

[tools.send.properties]
to = { type = "string", description = "peer slug or configured operator name" }
text = { type = "string", description = "message body, verbatim" }
image = { type = "string", optional = true, description = "path to a PNG, JPEG, GIF or WebP file to show on the reply; operator replies only (cousin-reply --image)" }
video = { type = "string", optional = true, description = "path to an MP4, WebM, MOV or M4V file to show on the reply, instead of image; operator replies only (cousin-reply --video)" }

[tools.send.commands.peer]
command = "cousin-chat"
argv = ["send", "{to}", "{text}"]

[tools.send.commands.operator]
command = "cousin-reply"
options = { to = "--user", image = "--image", video = "--video" }
stdin = ["text"]

[tools.job]
command = "cousin-job"
description = "Track sub-agents and background work: start, done, fail, list, show, and run, which launches a long shell command as a tracked job (its output in the row's log, the row closed with its exit code) and returns the job id at once."

[tools.job.properties]
# shell is left out of the kind enum on purpose: start takes no command,
# so a shell row started here would stay "running" forever. The adapter
# enforces the enum and answers with the description below.
kind = { type = "string", enum = ["subagent", "build", "other"], description = "(start) not shell: start takes no command, so a shell row would never close. For a long shell command use `run`, which launches it and closes the row with its exit code (or a Bash call with run_in_background, tracked by the job hooks)" }
title = { type = "string", description = "(start, run)" }
desc = { type = "string", description = "context for the job (start, run)" }
id = { type = "integer", description = "job id (done, fail, show)" }
summary = { type = "string", optional = true, description = "(done, fail)" }
exit = { type = "integer", description = "exit code (fail)" }
status = { type = "string", description = "filter (list)" }
mine = { type = "boolean", description = "only this cousin's jobs (list)" }
active = { type = "boolean", description = "(list)" }
json = { type = "boolean", description = "machine output (start, list, show)" }
argv = { type = "array", items = "string", description = "the command as a list, one element per argument, never a shell string (run)" }
log = { type = "string", optional = true, description = "log file, relative to your home (not absolute, no .., not in .secrets); default: the job's own log under data/job-logs (run)" }

[tools.job.commands.start]
# The title after `--`: whatever it says, it is never read as an option.
argv = ["start", "{kind}", "--", "{title}"]
options = { desc = "--desc", json = "--json" }

[tools.job.commands.run]
# `cousin-job start shell [options] -- TITLE CMD`: the command is launched
# detached and closes its own row. Options land before the `--`, and the
# title after it, so a title such as "--json" is never read as an option.
# --home-log confines the log to the home.
argv = ["start", "shell", "--json", "--", "{title}", "{argv}"]
options = { desc = "--desc", log = "--home-log" }

[tools.job.commands.done]
argv = ["done", "{id}", "{summary}"]

[tools.job.commands.fail]
argv = ["fail", "{id}", "{summary}"]
options = { exit = "--exit" }

[tools.job.commands.list]
argv = ["list"]
options = { status = "--status", mine = "--mine", active = "--active", json = "--json" }

[tools.job.commands.show]
argv = ["show", "{id}"]
options = { json = "--json" }

[tools.meeting]
command = "cousin-meeting"
description = "Speak in a meeting when it is your turn: say, pass, minutes (when you facilitate the close), show. A turn arrives as a line starting (Meeting <id> ...). Speak only on your turn; one answer per turn."

[tools.meeting.properties]
id = { type = "integer", description = "meeting id" }
text = { type = "string", optional = true, description = "what you say (say, minutes)" }

[tools.meeting.commands.say]
argv = ["say", "{id}", "--stdin"]
stdin = ["text"]

[tools.meeting.commands.pass]
argv = ["pass", "{id}"]

[tools.meeting.commands.minutes]
argv = ["minutes", "{id}", "--stdin"]
stdin = ["text"]

[tools.meeting.commands.show]
argv = ["show", "{id}"]

[tools.schedule]
command = "cousin-schedule"
description = "One-shot future prompts to yourself: add, list, cancel."

[tools.schedule.properties]
when = { type = "string", description = "e.g. 'in 30m' or 'tomorrow 09:00' (add)" }
prompt = { type = "string", description = "(add)" }
id = { type = "integer", description = "(cancel)" }
all = { type = "boolean", description = "include fired entries (list)" }

[tools.schedule.commands.add]
argv = ["add", "{when}", "{prompt}"]

[tools.schedule.commands.list]
argv = ["list"]
options = { all = "--all" }

[tools.schedule.commands.cancel]
argv = ["cancel", "{id}"]
