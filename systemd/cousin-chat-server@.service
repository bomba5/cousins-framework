[Unit]
Description=cousin-framework chat server for cousin %i
After=network.target

[Service]
Type=simple
WorkingDirectory={{ROOT}}
Environment=FRAMEWORK_ROOT={{ROOT}}
Environment=PATH={{USER_BIN}}:%h/.local/bin:{{SYSTEM_PATH}}
Environment=PYTHONUNBUFFERED=1
ExecStart={{USER_BIN}}/cousin-chat-server --home {{ROOT}}/cousins/%i
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
