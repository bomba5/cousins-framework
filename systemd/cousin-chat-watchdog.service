[Unit]
Description=cousin-framework chat-server watchdog (spawn a missing server, alert on a sick one, never kill)
After=network.target

[Service]
Type=oneshot
WorkingDirectory={{ROOT}}
Environment=FRAMEWORK_ROOT={{ROOT}}
Environment=PATH={{USER_BIN}}:%h/.local/bin:{{SYSTEM_PATH}}
Environment=PYTHONUNBUFFERED=1
ExecStart={{USER_BIN}}/cousin-chat-watchdog
TimeoutStartSec=2min
