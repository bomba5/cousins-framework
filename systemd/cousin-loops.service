[Unit]
Description=cousin-framework loops daemon (heartbeats, loops, timed flips)
After=network.target

[Service]
Type=simple
# Chat servers (and, for loops, flip respawns) are launched from this
# process; a restart must not take them down with it.
KillMode=process
WorkingDirectory={{ROOT}}
Environment=FRAMEWORK_ROOT={{ROOT}}
Environment=PATH={{USER_BIN}}:{{SYSTEM_PATH}}
ExecStart={{USER_BIN}}/cousin-loops run --interval 30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
