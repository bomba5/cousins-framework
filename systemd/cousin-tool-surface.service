[Unit]
Description=cousin-framework tool-surface manifest (data/tool-surface.md from every cousin-* --help)

[Service]
Type=oneshot
WorkingDirectory={{ROOT}}
Environment=FRAMEWORK_ROOT={{ROOT}}
Environment=PATH={{USER_BIN}}:{{SYSTEM_PATH}}
ExecStart={{USER_BIN}}/cousin-tool-surface --bin {{USER_BIN}}
TimeoutStartSec=10min
