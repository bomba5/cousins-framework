# node.env - the hive node's configuration. cousin-spawn-node writes the
# real one into the archive (owner-only: it carries the bearer token);
# this example documents every key. install.sh loads it and the systemd
# unit reads it as its EnvironmentFile.

# Identity. The slug is what the queen knows this node as; the token
# was minted for exactly this slug.
COUSIN_SLUG=testa
NODE_NAME=Testa
# One line the queen shows on the node's card (sent with each checkin).
NODE_ROLE="test node"

# The node's own chat surface. Loopback by default. 0.0.0.0 lets the
# console (its queen) proxy chat to it; off loopback the node answers
# /api/* only to a caller presenting this node's own HIVE_TOKEN as a
# bearer, and /health to anyone.
NODE_PORT=8210
NODE_HOST=127.0.0.1

# The queen, reached outbound only, and the bearer token that IS this
# node's identity there. Rotate by minting a new token on the queen,
# replacing this line, and restarting the unit.
QUEEN_URL=http://queen.example.invalid:8101
HIVE_TOKEN=hive_replace-with-the-minted-token

# Optional: a home chat server the [tell-home: ...] marker posts to
# (this framework's /api/send). Empty means the marker is a no-op.
HOME_CHAT_URL=

# Optional: the backend. One command line; the prompt arrives on stdin,
# the reply is stdout. Empty means the placeholder brain, which greets,
# echoes, and still remembers, so the node is never dead on arrival.
# Example: AGENT_CMD=/usr/local/bin/my-agent --plain
AGENT_CMD=

# How often to poll the inbox on the queen, in seconds (0 disables),
# and how long one backend call may take.
NODE_POLL_SECONDS=5
AGENT_TIMEOUT_SECONDS=120
