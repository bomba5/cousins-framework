# <home>/policy.toml - what this cousin's model may not do, as code.
# Absent: everything allowed, said once in the event stream at start.
# Malformed: the runner refuses to start (rc 2) and says which key.
# Enforced for every tool call, a subagent's own calls included.
# A guardrail, not a sandbox: a pattern stops the command line it names,
# not every way to get the same effect.
# This file lives in the home it governs, so the model can rewrite it; a
# rewrite takes effect at the next start. To make it immutable, make it
# read-only to the cousin's user, or own it.
# To deny subagents, list both "Task" and "Agent".
# The patterns skip the cousin's own mcp__cousin__* tools: their `command`
# is a verb such as "add" or "pass", not a command line.
# Never deny mcp__cousin__handoff: every generation ends through it.
deny_tools = ["WebFetch", "WebSearch"]              # exact names or prefix*
deny_bash_patterns = [                                # regexes on any tool's string `command` (Bash, PowerShell, Monitor, ...)
    '\brm\s+-rf\s+/',
    '\bgit\s+push\s+--force',
    # operator-run: a cousin never obtains credentials (a guardrail; the
    # files are the same Unix user's until phase 6)
    '\bcousin-account\b',
]
ask = []                                              # operator approval; no approval surface yet: enforced as deny
outbound_filter = true                                # reply and send cross config/outbound-filter.json
